#!/usr/bin/env bash
# tailscale stand-in inside the e2e test server (ops/test/e2e.sh): no network. Records every call in
# /var/lib/tailscale-stub/calls. "up" prints a login link and finishes once the test creates
# /var/lib/tailscale-stub/approve (the owner logging in); "serve" keeps its config like tailscaled does.
set -euo pipefail
S=/var/lib/tailscale-stub
mkdir -p "$S"
echo "$*" >> "$S/calls"
case "$1 ${2:-}" in
  "status --json")
    if [ -e "$S/logged-in" ]; then echo '{"BackendState":"Running","Self":{"DNSName":"zeroed.tail-e2e.ts.net."}}'; else echo '{"BackendState":"NeedsLogin"}'; fi ;;
  "up "*)
    printf '\nTo authenticate, visit:\n\n\thttps://login.tailscale.com/a/e2e0a1b2c3d4\n\n'
    for _ in $(seq 1 120); do [ -e "$S/approve" ] && { touch "$S/logged-in"; echo Success.; exit 0; }; sleep 1; done
    echo 'timeout waiting for login'; exit 1 ;;
  "serve --bg")
    printf '{"TCP":{"443":{"HTTPS":true}},"Web":{"zeroed.tail-e2e.ts.net:443":{"Handlers":{"/":{"Proxy":"%s"}}}}}\n' "${@: -1}" > "$S/serve.json" ;;
  "serve status")
    cat "$S/serve.json" 2>/dev/null || echo '{}' ;;
  "serve reset")
    rm -f "$S/serve.json" ;;
  "funnel "*) ;;
  *) echo "tailscale stub: unhandled $*" >&2; exit 1 ;;
esac
