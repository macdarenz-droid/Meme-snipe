{
  "name": "@meme-snipe/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "build:preview": "VITE_PREVIEW=1 vite build && node scripts/check-build.mjs --preview",
    "android:sync": "pnpm build:preview && cap sync android",
    "screenshots:preview": "node scripts/preview-screenshots.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "motion": "14.0.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsqr": "1.4.0",
    "vite": "8.3.2"
  }
}
