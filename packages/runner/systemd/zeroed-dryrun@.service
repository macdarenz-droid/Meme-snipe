# RUN-1 on the OPS-1 host: drills and evidence for the qualifying dry run (docs/ARCHITECTURE.md §15, §20).
# One instance per requested run name: zeroed-dryrun-tick.timer starts zeroed-dryrun@<name> when the deployed
# release holds packages/runner/qualifying-run.json, and resumes it by name after a reboot or a runner crash.
# Root only for `systemctl kill` (the restart drill) and to read the worker's journal; it holds no secret
# and talks to the worker on 127.0.0.1 only.
[Unit]
Description=Zeroed dry run %i (drills and evidence)
After=zeroed-worker.service
Wants=zeroed-worker.service
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/zeroed/current
ExecStart=/usr/local/bin/node --no-warnings /opt/zeroed/current/packages/runner/src/cli.ts run --mode systemd --run-name %i --state-dir /var/lib/zeroed --evidence-root /var/lib/zeroed-dryrun/evidence --hours 48
# A crash (exit 1) restarts and resumes by name. Refused (2) or aborted (4) never restarts: the run is over.
Restart=on-failure
RestartPreventExitStatus=2 4
RestartSec=30
# zeroed-tabletop: the host-loss tabletop's state dir (the newest backup is decrypted there, never into the live one).
StateDirectory=zeroed-dryrun zeroed-tabletop
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/zeroed
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
